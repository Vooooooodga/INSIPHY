+"""Synthetic configuration guide generated by the same V19 inference API."""
+from __future__ import annotations
+from dataclasses import replace
+import json
+from pathlib import Path
+import tempfile
+from ..structure.types import Catalogue, ExonSpan, ExonConfiguration, ObservationEvidence
+from ..structure.serialization import write_catalogues, write_json
+from ..storage.tabular import write_tsv
+from ..inference.configuration_run import infer_configurations
+from .exon_results import render_exon_results
+
+
+def render_guide(output_dir, *, png=False):
+    out = Path(output_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="intraphy-exon-guide-") as tmp:
+        tmp = Path(tmp)
+        full = ExonConfiguration((ExonSpan(0, 180),))
+        split = ExonConfiguration((ExonSpan(0, 60), ExonSpan(90, 180)))
+        obs = tuple(ObservationEvidence(s, (split if s == "D" else full,)) for s in "ABCD")
+        c = Catalogue("Synthetic_exon", "local_structure", 180,
+                      (ExonSpan(0, 180), ExonSpan(0, 60), ExonSpan(90, 180)), ((60, 90),),
+                      observations=obs, boundary_candidates=(ExonSpan(0, 180), ExonSpan(0, 60), ExonSpan(90, 180)))
+        write_catalogues(tmp/"catalogue.jsonl", (c,))
+        rows = [{"node_id": "root", "parent_id": "", "label": "root", "branch_length": "NA"},
+                {"node_id": "AB", "parent_id": "root", "label": "AB", "branch_length": .2},
+                {"node_id": "CD", "parent_id": "root", "label": "CD", "branch_length": .2}]
+        rows += [{"node_id": s, "parent_id": "AB" if s in "AB" else "CD", "label": s, "branch_length": .2} for s in "ABCD"]
+        write_tsv(tmp/"species_tree.tsv", rows, ["node_id", "parent_id", "label", "branch_length"])
+        infer_configurations(tmp, tmp/"result", configurations=tmp/"catalogue.jsonl", observation_view="annotation")
+        records = render_exon_results(tmp/"result", out)
+        teaching = json.loads((tmp/"result/exon_history.json").read_text())
+        write_json(out/"illustrative_model.json", {"synthetic": True, "model": teaching["model"], "example": teaching["units"]})
+    for record in records:
+        record["purpose"] = "synthetic_teaching_schematic"
+        record["data_result"] = False
+        record["caption"] = ("A retained ancestral exon can become two exons by internal intronization. "
+                             "The missing middle from mature exon sequence is not a DNA deletion. "
+                             "One added separator is one split, not exon death plus two exon births.")
+    (out/"figure_manifest.json").write_text(json.dumps(records, indent=2)+"\n")
+    page = (out/"index.html").read_text().replace('<h1>Exon structure evolution</h1>',
+        '<h1>V19 exon configuration model: synthetic teaching example</h1>'
+        '<p><strong>Object:</strong> one exon, or a dependent group of exons. '
+        '<strong>State:</strong> their ordered boundaries and material provenance. '
+        '<strong>Changes:</strong> elementary splits, fusions, boundary shifts, exon appearance/inactivation and interval indels.</p>'
+        '<p>Maximum parsimony minimizes allowed edit paths. The optional continuous-time model uses those same edits '
+        'to construct Q and sums over ancestral configurations. Supplied rate parameters are not evidence for a mutation mechanism.</p>')
+    (out/"index.html").write_text(page)
+    if png:
+        try:
+            import cairosvg
+        except ImportError as exc:
+            raise RuntimeError("PNG rendering requires optional CairoSVG") from exc
+        for record in records:
+            path = out/record["svg"]
+            cairosvg.svg2png(url=str(path), write_to=str(path.with_suffix(".png")), scale=1.5)
+    return records
