index 0000000..7caa64b
--- /dev/null
+++ b/src/intraphy/reporting/exon_results.py
@@ -0,0 +1,144 @@
+"""Read-only V19 tree/exon diagrams linked to the unique structural-edit table."""
+from __future__ import annotations
+from html import escape
+import json
+from pathlib import Path
+import re
+from ..run_result import result_model
+from ..topology import SpeciesTree
+from ..storage.tabular import read_tsv
+from ..storage.fasta import parse_fasta
+
+
+def _text(x, y, value, size=14, anchor="start"):
+    return f'<text x="{x:.2f}" y="{y:.2f}" font-size="{size}" text-anchor="{anchor}">{escape(str(value))}</text>'
+
+
+def _line(x1, y1, x2, y2, stroke="#455565", dash=""):
+    return f'<line x1="{x1:.2f}" y1="{y1:.2f}" x2="{x2:.2f}" y2="{y2:.2f}" stroke="{stroke}" stroke-width="1.5" stroke-dasharray="{dash}"/>'
+
+
+def _rect(x, y, w, h, fill="#427788", dash=""):
+    return f'<rect x="{x:.2f}" y="{y:.2f}" width="{max(w, .5):.2f}" height="{h}" fill="{fill}" stroke="#294353" stroke-dasharray="{dash}"/>'
+
+
+def _tree_positions(tree, by_species):
+    y, depth = {}, {tree.root: 0}
+    cursor = 150
+    for leaf in tree.leaves:
+        species = tree.label[leaf]
+        o = by_species.get(species, {})
+        count = max(1, len(o.get("configurations", ())))
+        y[leaf] = cursor
+        cursor += max(80, count*32+35)
+    for node in tree.postorder():
+        if tree.children.get(node):
+            y[node] = sum(y[c] for c in tree.children[node])/len(tree.children[node])
+    for node in tree.preorder():
+        for child in tree.children.get(node, ()):
+            depth[child] = depth[node]+1
+    return {v: 35+110*depth[v]/max(1, max(depth.values())) for v in depth}, y, cursor
+
+
+def draw_unit(unit, tree, events, alignment=None, path=None):
+    c = unit["catalogue"]
+    by_species = {o["species"]: o for o in c["observations"]}
+    x, y, bottom = _tree_positions(tree, by_species)
+    width, height = 1400, bottom+max(110, len(events)*24+65)
+    left, scale = 410., 890./max(1, c["length"])
+    elements = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">',
+        '<rect width="100%" height="100%" fill="white"/>',
+        '<g font-family="Arial, sans-serif" fill="#20313D">',
+        _text(30, 35, f"{c['family']} / {c['unit']}: exon structures on the species tree", 22),
+        _text(30, 62, "Boxes: native annotated exons. Additional lanes: coexisting annotations, not inferred usage.", 14),
+        _text(30, 84, "Ancestral labels refer to configuration states; they are not reconstructed full transcripts.", 14),
+        _text(30, 108, "Branch lengths are schematic. Possible placements must not be added together.", 13)]
+    for parent, child in tree.edges():
+        elements.extend([_line(x[parent], y[parent], x[parent], y[child]), _line(x[parent], y[child], x[child], y[child])])
+        labels = [e["event_id"].split("/")[-1] + ("?" if e["support"] != "required" else "")
+                  for e in events if e["parent"] == parent and e["child"] == child]
+        if labels:
+            elements.append(_text(x[child]+4, y[child]-10, ",".join(labels), 11))
+    for node in tree.preorder():
+        if tree.children.get(node):
+            elements.append(f'<circle cx="{x[node]}" cy="{y[node]}" r="3" fill="#20313D"/>')
+    if alignment:
+        # Pair only consecutive annotated taxa and genuine aligned nucleotide
+        # runs. No ribbon fills an inserted intron or an unknown base interval.
+        labels = [tree.label[n] for n in tree.leaves]
+        for sa, sb in zip(labels, labels[1:]):
+            if sa not in alignment or sb not in alignment:
+                continue
+            oa, ob = by_species.get(sa, {}), by_species.get(sb, {})
+            if oa.get("kind") not in {"observed", "partial"} or ob.get("kind") not in {"observed", "partial"}:
+                continue
+            ca, cb = oa.get("configurations", ()), ob.get("configurations", ())
+            if len(ca) != 1 or len(cb) != 1:
+                continue
+            offset = c["alignment_offset"]
+            for ea in ca[0]["exons"]:
+                for eb in cb[0]["exons"]:
+                    a, b = max(ea["start"], eb["start"]), min(ea["end"], eb["end"])
+                    valid = "".join("x" if alignment[sa][offset+i] in "ACGT" and alignment[sb][offset+i] in "ACGT" else "." for i in range(a, b))
+                    for run in re.finditer("x+", valid):
+                        l, r = left+scale*(a+run.start()), left+scale*(a+run.end())
+                        ya, yb = y[tree.leaf_by_label[sa]]+11, y[tree.leaf_by_label[sb]]-11
+                        elements.append(f'<path d="M{l},{ya} L{r},{ya} L{r},{yb} L{l},{yb} Z" fill="#aac7cf" opacity="0.3"/>')
+    for leaf in tree.leaves:
+        species = tree.label[leaf]
+        o = by_species.get(species, {})
+        elements.append(_text(175, y[leaf]+5, species, 14))
+        elements.append(_text(175, y[leaf]+23, o.get("kind", "unknown"), 11))
+        configs = o.get("configurations", ()) or [{"exons": []}]
+        for lane, config in enumerate(configs):
+            yy = y[leaf]+lane*30
+            elements.append(_line(left, yy, left+scale*c["length"], yy, "#9babb3"))
+            for e in config["exons"]:
+                elements.append(_rect(left+scale*e["start"], yy-10, scale*(e["end"]-e["start"]), 20,
+                                      "#e1e6e8" if o.get("kind") in {"unknown", "excluded"} else "#427788"))
+            if not config["exons"]:
+                elements.append(_text(left+10, yy-10, "No annotated exon here; see material and observation evidence", 12))
+        for candidate in o.get("alternative_exons", ()):
+            elements.append(_rect(left+scale*candidate["start"], y[leaf]+17,
+                                  scale*(candidate["end"]-candidate["start"]), 9, "none", "4,3"))
+    yy = bottom+10
+    elements.append(_text(30, yy, "Elementary edits: conditional on sequence correspondence, annotation evidence and the declared model", 15))
+    for e in events:
+        yy += 24
+        elements.append(_text(30, yy, f"{e['event_id'].split('/')[-1]}  {e['operation']}  {e['support']}  {e['parent']} -> {e['child']}  {e.get('consequences', '')}", 12))
+    if not events:
+        elements.append(_text(30, yy+26, "No required/possible edit is listed. Check the summary: unresolved input is not proof of conservation.", 13))
+    elements.extend(['</g>', '</svg>'])
+    svg = "\n".join(elements)
+    if path is not None:
+        Path(path).write_text(svg+"\n")
+    return svg
+
+
+def render_exon_results(result_dir, output_dir):
+    result, out = Path(result_dir), Path(output_dir)
+    if result_model(result) not in {"exon-parsimony", "exon-ctmc"}:
+        raise ValueError("Expected completed V19 result")
+    data = json.loads((result/"exon_history.json").read_text())
+    tree = SpeciesTree(data["tree"])
+    events = read_tsv(result/"structural_history.tsv")
+    preparation = {r["family_id"]: r for r in read_tsv(result/"exon_preparation_summary.tsv", optional=True)}
+    out.mkdir(parents=True, exist_ok=True)
+    figures, sections = [], []
+    for index, unit in enumerate(data["units"], 1):
+        relevant = [r for r in events if r["family_id"] == unit["family_id"] and r["unit_id"] == unit["unit_id"]]
+        record = preparation.get(unit["family_id"], {})
+        source = result/record.get("evidence_directory", "")/"genomic_alignment.fa"
+        alignment = parse_fasta(source) if source.is_file() else None
+        filename = f"exon_structure_{index:05d}.svg"
+        draw_unit(unit, tree, relevant, alignment, out/filename)
+        figures.append({"family": unit["family_id"], "unit": unit["unit_id"], "svg": filename,
+                        "computed_from": "exon_history.json; structural_history.tsv", "inference_performed_by_renderer": False})
+        sections.append(f'<h2>{escape(unit["family_id"])} / {escape(unit["unit_id"])}</h2><object data="{filename}" type="image/svg+xml" style="width:100%"></object>')
+    (out/"figure_manifest.json").write_text(json.dumps(figures, indent=2)+"\n")
+    (out/"index.html").write_text('<!doctype html><html lang="en"><meta charset="utf-8"><title>IntraPhy exon structures</title>'
+        '<style>body{font:16px Arial;max-width:1400px;margin:30px auto;padding:20px}object{margin:10px 0 35px}</style>'
+        '<h1>Exon structure evolution</h1><p>Only genomic sequence and annotation are used. No exon usage is inferred. '
+        'Dashed marks denote candidate annotation/boundary alternatives. Read the diagnostics before interpreting missing events.</p>'
+        +''.join(sections)+'</html>\n')
+    return figures
